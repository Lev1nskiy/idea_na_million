{
  "_comment": "Маркеры категории I (спор/претензия/агрессия) для лексического pre-classifier. Элементы — regex-фрагменты (без учёта регистра; перед каждым добавляется \\b). Срабатывание даёт мгновенный ACK без LLM; пропущенный «тонкий» спор поймает LLM на слое Understanding.",
  "groups": {
    "claim": [
      "претензи\\w*",
      "жалоб\\w*",
      "жалуюсь|пожалуюсь|пожалуемся|буду\\s+жаловаться|подам\\s+жалобу",
      "обман\\w*",
      "мошенни\\w*",
      "кинул\\w*|кидалов\\w*",
      "недопустим\\w*",
      "возмутительн\\w*|возмущ\\w*",
      "безобраз\\w*",
      "ужасн\\w*\\s+(?:сервис|обслуживан\\w*|качеств\\w*|менеджер\\w*|работ\\w*)",
      "отвратительн\\w*",
      "неприемлем\\w*",
      "хамств\\w*|хамит\\w*|нахамил\\w*",
      "некомпетентн\\w*",
      "издевательств\\w*|издеваетесь",
      "разочарован\\w*",
      "больше\\s+никогда|никогда\\s+больше|в\\s+последний\\s+раз",
      "сколько\\s+можно",
      "требую\\w*",
      "немедленно\\s+(?:верните|решите|ответьте|исправьте)"
    ],
    "refund_legal": [
      "верните\\s+(?:мне\\s+)?(?:все\\s+)?(?:деньги|оплату|средства)",
      "суд(?:е|у|ом|а|ы)?",
      "иск(?:а|у|ом|и)?",
      "прокуратур\\w*",
      "роспотребнадзор\\w*",
      "юрист\\w*|адвокат\\w*",
      "защит\\w+\\s+прав\\s+потребител\\w*",
      "полици\\w*",
      "арбитраж\\w*"
    ],
    "aggression": [
      "идиот\\w*|дебил\\w*|придур\\w*|кретин\\w*|тупиц\\w*|дурак\\w*",
      "достал\\w*|бесит\\w*|ненавиж\\w*",
      "пошл[аи]?\\s+вы|идите\\s+(?:вы\\s+)?к\\s+чёрту",
      "бля[дт]\\w*|сука|суки|хуй\\w*|хуе\\w*|пизд\\w*|ебан\\w*|заеб\\w*|ёбан\\w*"
    ],
    "threat": [
      "уйду\\s+к\\s+конкурент\\w*|перейду\\s+к\\s+конкурент\\w*|пойду\\s+к\\s+конкурент\\w*|уйд[её]м\\s+к\\s+конкурент\\w*",
      "откажусь\\s+от\\s+(?:заказа|сотрудничества|договора)",
      "расторг\\w*",
      "негативн\\w*\\s+отзыв\\w*|плох\\w*\\s+отзыв\\w*|напишу\\s+отзыв",
      "расскажу\\s+всем|разгромн\\w*",
      "в\\s+соцсет\\w*"
    ],
    "price_dispute": [
      "слишком\\s+дорого|так\\s+дорого|почему\\s+(?:так\\s+)?дорого",
      "завышенн\\w*\\s+цен\\w*|завышаете",
      "цена\\s+(?:выросла|изменилась|не\\s+та|не\\s+совпада\\w*)|цен\\w*\\s+не\\s+совпад\\w*",
      "обещали\\s+(?:другую|ниже|дешевле|меньше)",
      "дешевле\\s+у\\s+конкурент\\w*|у\\s+конкурент\\w*\\s+дешевле|в\\s+другом\\s+месте\\s+дешевле|где-то\\s+дешевле",
      "переплат\\w*",
      "по\\s+другой\\s+цене"
    ],
    "out_of_price": [
      "вне\\s+прайс\\w*",
      "нет\\s+в\\s+(?:каталоге|прайсе|прайс-листе)",
      "нестандартн\\w*\\s+(?:заказ|продукц\\w*|изделие|модель)",
      "изготов\\w*\\s+(?:на\\s+заказ|по\\s+(?:моим|нашим)\\s+чертеж\\w*)",
      "под\\s+(?:мои|наши)\\s+(?:размеры|чертежи|параметры|требования)",
      "специальн\\w*\\s+(?:принтер|мфу|модель|издели\\w*)",
      "индивидуальн\\w*\\s+(?:изготовлен\\w*|производств\\w*)"
    ],
    "english": [
      "complain\\w*|complaint\\w*",
      "refund\\w*",
      "lawsuit|sue\\s+you|lawyer|attorney",
      "scam\\w*|fraud\\w*|ripped\\s+off|cheated",
      "unacceptable|outrageous|ridiculous",
      "terrible|awful|horrible|worst",
      "never\\s+again|last\\s+time",
      "idiot\\w*|stupid",
      "fuck\\w*|shit\\w*|bullshit"
    ]
  }
}
