# Пример окружения. Скопировать в .env: `cp .env.example .env`
# .env уже в .gitignore — секреты в репозиторий не попадают.

# --- База данных ---
# SQLite по умолчанию; замена на Postgres — одна строка (ядро не знает про СУБД).
DB_URL=sqlite:///./crm.db

# --- LLM (Шаг 2) ---
# Порядок провайдеров. auto (по умолчанию) — сначала облако, у которого есть ключи
# (gigachat → yandex), затем mock. Можно задать явно список: gigachat,yandex или yandex,gigachat.
# mock — только демо-движок, без обращений в сеть. Mock всегда замыкает цепочку.
LLM_PROVIDER=auto
# Бюджет времени на один вызов модели, секунды. Облако не успело — цепочка уходит дальше, в mock.
LLM_TIMEOUT_S=2.5

# GigaChat (Сбер): ключ авторизации из личного кабинета GigaChat API.
# GIGACHAT_SCOPE: GIGACHAT_API_PERS (физлица) | GIGACHAT_API_B2B (юрлица, предоплата) | GIGACHAT_API_CORP (постоплата).
# GIGACHAT_MODEL: GigaChat-2 | GigaChat-2-Pro | GigaChat-2-Max (список моделей — client.get_models()).
# TLS: скачайте «Russian Trusted Root CA» с gosuslugi.ru/crt и укажите путь в GIGACHAT_CA_BUNDLE_FILE —
# это правильнее, чем GIGACHAT_VERIFY_SSL=false (последнее допустимо только для локальной отладки).
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_VERIFY_SSL=false
GIGACHAT_CA_BUNDLE_FILE=
GIGACHAT_MAX_TOKENS=0

# YandexGPT (Yandex Cloud): сервисному аккаунту нужна роль ai.languageModels.user.
# YANDEX_API_KEY — статический API-ключ сервисного аккаунта; YANDEX_IAM_TOKEN — альтернатива (живёт 12 ч).
# YANDEX_FOLDER_ID — идентификатор каталога, на который выдана роль.
# YANDEX_MODEL: yandexgpt-5-lite | yandexgpt-5-pro | yandexgpt-5.1; YANDEX_MODEL_URI — полный
# gpt://<каталог>/<модель> (например, для дообученной модели) и имеет приоритет над YANDEX_MODEL.
YANDEX_API_KEY=
YANDEX_IAM_TOKEN=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-5-lite
YANDEX_MODEL_URI=
YANDEX_MAX_TOKENS=800
# Пусто — режим рассуждений выключен для моделей 5-го поколения Pro/Lite (ответ короче и быстрее),
# у остальных моделей поле не отправляется. DISABLED/ENABLED — задать явно.
YANDEX_REASONING_MODE=

# Локальная модель на своей машине — бесплатный вариант с открытыми весами
# (GigaChat-20B-A3B — MIT, YandexGPT-5-Lite-8B). Один провайдер закрывает Ollama,
# LM Studio, llama.cpp и vLLM: у всех OpenAI-совместимый /chat/completions.
# Пусто в LOCAL_MODEL → провайдер выключен. Ключ нужен только сторонним шлюзам.
LOCAL_MODEL=
LOCAL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_API_KEY=
LOCAL_MAX_TOKENS=800

# --- Админ-API переноса данных (Шаг 5) ---
# Пусто → /api/admin/* отвечают 503: по умолчанию наружу ничего не отдаём (Ст. 4).
ADMIN_TOKEN=
# Сервисный токен бота-анкеты: им защищён POST/GET /api/leads (без него ручка отвечает 503).
BOT_API_TOKEN=

# --- Telegram-бот (Шаг 6) ---
# Токен от @BotFather; chat_id менеджера — от @userinfobot (можно несколько через запятую).
TG_BOT_TOKEN=
# Отдельный бот-анкета (channels/telegram_lead_bot.py): собирает данные о человеке и заводит
# карточку клиента. Токен берётся у @BotFather отдельно от клиентского чат-бота.
TG_LEAD_BOT_TOKEN=
TG_MANAGER_CHAT_ID=
# Чат, который подсказывается непривязанному пользователю в демо: `--check` покажет привязки.
TG_DEMO_CLIENT_ID=1
# Ссылка на дашборд, которую бот шлёт менеджеру в уведомлениях.
UI_URL=http://localhost:8501

# --- Фронтенд (необязательно) ---
# Каталог со сборкой сайта (index.html + assets). Пусто → приложение работает только как API.
# Пример: FRONTEND_DIR=./frontend   (в Docker: /app/frontend, см. docker-compose.yml)
FRONTEND_DIR=

# --- Прочее ---
LOG_LEVEL=INFO
