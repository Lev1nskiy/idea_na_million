# Локальный запуск: файл можно не создавать — демо-движок работает без внешних сервисов.
# Postgres нужен только для персистентности (вариант production-профиля).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Провайдеры LLM из roadmap (в этом фронтенд-MVP движок — детерминированный MockLLM):
# LLM_PROVIDER=mock   # mock | gigachat | yandex
# GIGACHAT_CREDENTIALS=
# YANDEX_API_KEY=
# TG_BOT_TOKEN=

# Базовый URL внешнего backend (опционально). Если пусто — UI ходит на встроенные API-роуты.
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
