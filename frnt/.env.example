# Локальный запуск: файл можно не создавать — демо-движок работает без внешних сервисов.
# Postgres нужен только для персистентности (вариант production-профиля).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Провайдеры LLM из roadmap (в этом фронтенд-MVP движок — детерминированный MockLLM):
# LLM_PROVIDER=mock   # mock | gigachat | yandex
# GIGACHAT_CREDENTIALS=
# YANDEX_API_KEY=
# TG_BOT_TOKEN=

# Бэкенд (FastAPI + SQLite) — источник истины для данных, политики и метрик.
# Если переменная пуста или бэкенд недоступен, сайт отвечает через встроенный демо-движок.
# Локально: uvicorn app.main:app --port 8030 в папке ai-native-srm.
CRM_BACKEND_URL=http://127.0.0.1:8030
# Таймаут обращения к бэкенду, мс (превышение = ответ фоллбека, демо не «зависает»).
CRM_BACKEND_TIMEOUT_MS=3000

# Dev-ресурсы Next (HMR) с внешних хостов: нужно, если dev-сервер открывают через туннель
# или превью-хост. Пусто = только localhost.
# NEXT_DEV_ALLOWED_ORIGINS=*.preview.example,local-origin.dev

# Прямой адрес API из браузера (не нужен при работе через CRM_BACKEND_URL).
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8030
